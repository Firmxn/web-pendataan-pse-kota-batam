# ==============================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT (.env.example)
# Web Pendataan PSE Kota Batam
#
# PETUNJUK INSTALASI:
# 1. Salin file ini dan ubah namanya menjadi '.env'
# 2. Isi nilai-nilai variabel di bawah ini sesuai lingkungan (Lokal / Produksi)
# 3. Jalankan 'php artisan key:generate' untuk mengisi APP_KEY secara otomatis
# ==============================================================================

# === 1. KONFIGURASI UTAMA APLIKASI ===
APP_NAME="Web Pendataan PSE"
# LOKAL: 'local' | PRODUKSI: 'production' (Wajib diatur ke 'production' pada server live)
APP_ENV=local
# PENTING: Wajib diisi menggunakan 'php artisan key:generate'
APP_KEY=
# LOKAL: 'true' (Menampilkan detail error untuk debugging)
# PRODUKSI: 'false' (Menyembunyikan detail error/stack trace agar tidak dieksploitasi peretas)
APP_DEBUG=true
# LOKAL: 'http://localhost' atau 'http://127.0.0.1:8000'
# PRODUKSI: URL domain resmi dengan protokol HTTPS, contoh: 'https://pse.batam.go.id'
APP_URL=http://localhost
# Zona waktu default aplikasi (opsional di lokal, direkomendasikan Asia/Jakarta di production)
APP_TIMEZONE=Asia/Jakarta

# === 2. KONFIGURASI KHUSUS PEMERINTAH KOTA BATAM ===
# Akhiran domain default untuk pengajuan subdomain instansi
DOMAIN_SUFFIX=batam.go.id

# === 3. INTEGRASI SINGLE SIGN-ON (SSO) ===
# Header untuk pengguna internal (petugas, verifikator_1, verifikator_2, admin, eksekutif)
BBS_SSO_EXC_HEADER=X-SSO-Exclusive
# Header untuk pengguna publik/masyarakat
BBS_SSO_PUB_HEADER=X-SSO-User

# === 4. PENCATATAN SISTEM (LOGGING) ===
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# LOKAL: 'debug' (Mencatat seluruh detail log untuk development)
# PRODUKSI: 'error' (Hanya mencatat log jika terjadi kegagalan sistem agar disk hemat)
LOG_LEVEL=debug

# === 5. KONEKSI DATABASE ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# LOKAL: nama database lokal Anda | PRODUKSI: nama database produksi di server Diskominfo
DB_DATABASE=db_pse_batam
# LOKAL: username database lokal | PRODUKSI: username database server produksi
DB_USERNAME=root
# LOKAL: password database lokal | PRODUKSI: password database server produksi
DB_PASSWORD=

# === 6. SISTEM DRIVER & SESSION ===
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# LOKAL: 'false' (Agar sistem dapat diakses via protokol HTTP biasa)
# PRODUKSI: 'true' (Memaksa browser hanya mengirimkan cookie sesi via koneksi aman HTTPS)
SESSION_SECURE_COOKIE=false

# === 7. KONEKSI CACHE LAIN (OPSIONAL) ===
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# === 8. KONFIGURASI LAYANAN EMAIL (SMTP) ===
# LOKAL: Biasanya menggunakan 'smtp' dengan host mail server lokal (seperti Mailpit/Mailtrap)
# PRODUKSI: Menggunakan mail server resmi Pemko Batam atau SMTP eksternal (seperti smtp.gmail.com)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# LOKAL: biasanya 'null' | PRODUKSI: biasanya 'tls' atau 'ssl'
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@batam.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# === 9. KONFIGURASI STORAGE AWAN AWS (OPSIONAL) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# === 10. INTEGRASI WEBSOCKET PUSHER (OPSIONAL) ===
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# === 11. KONFIGURASI FRONTEND (VITE & WEBSOCKET) ===
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
